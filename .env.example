# Required: Bybit V5 API credentials
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# Recommended: Start with testnet (default: true)
# Set to false only when you are ready to trade real funds
BYBIT_TESTNET=true

# Options module (default: false)
ENABLE_OPTIONS=false

# Options: allow naked short selling (default: false)
# Naked short options carry unlimited or very large maximum loss.
OPTIONS_ALLOW_NAKED_SHORT=false

# Options: max premium as percentage of USDC balance (default: no cap)
# OPTIONS_MAX_PREMIUM_PCT_BALANCE=10

# RFQ block-trade module (default: false)
# Adds 6 read-only/write RFQ tools. Read-only & dry-run until RFQ_ENABLE_WRITES is also true.
ENABLE_RFQ=false

# RFQ: live-submission kill-switch (default: false)
# While false, create_rfq/execute_quote are dry-run only even with dry_run=false.
# Keep false until RFQ endpoint paths are confirmed against a live RFQ-eligible
# account. Does NOT gate cancel_rfq (risk-reducing).
RFQ_ENABLE_WRITES=false

# RFQ: allow combos the risk engine cannot prove are risk-defined (default: false)
# Uncovered net-short or unmodelable mixed/unpriced legs. RFQ-path equivalent
# of OPTIONS_ALLOW_NAKED_SHORT.
RFQ_ALLOW_UNCOVERED=false
